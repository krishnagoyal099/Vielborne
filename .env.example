# SHADOWSELF — Environment Variables
# Copy this file to .env and fill in your token

# Get your free token at: https://huggingface.co/settings/tokens
# Create a token with READ permissions (free account, no Pro needed)
HF_TOKEN=hf_your_token_here

# AI Model — OpenBMB MiniCPM3-4B (default)
# Using OpenBMB model for hackathon prize eligibility (OpenBMB Award + Tiny Titan)
# openbmb/MiniCPM3-4B  → 4B params, free HF inference, no approval needed
# openbmb/MiniCPM4-8B  → newer, more capable, still qualifies for OpenBMB prize
HF_MODEL=openbmb/MiniCPM3-4B
